# crontab -e  (www-data yoki deploy foydalanuvchisi ostida)
APP=/srv/izdoshlar/backend
PY=/srv/izdoshlar/backend/.venv/bin/python

# Yuborilmagan buyurtma bildirishnomalarini har 10 daqiqada qayta urinish
*/10 * * * * cd $APP && $PY manage.py retry_notifications >> /var/log/izdoshlar-retry.log 2>&1

# Kundalik zaxira (03:30)
30 3 * * * /srv/izdoshlar/deploy/backup.sh >> /var/log/izdoshlar-backup.log 2>&1

# Eskirgan admin sessiyalarini tozalash (haftada bir)
0 4 * * 0 cd $APP && $PY manage.py clearsessions
