# /etc/systemd/system/izdoshlar.service
# Yoqish: systemctl daemon-reload && systemctl enable --now izdoshlar
# Loglar: journalctl -u izdoshlar -f
[Unit]
Description=Izdoshlar backend (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/izdoshlar/backend
EnvironmentFile=/srv/izdoshlar/backend/.env
ExecStart=/srv/izdoshlar/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 --workers 3 --timeout 30 --access-logfile -
Restart=always
RestartSec=3

# Qoʻshimcha himoya
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/izdoshlar/backend/media

[Install]
WantedBy=multi-user.target
