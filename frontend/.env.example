# Nusxa oling: cp .env.example .env
# Supabase loyihasi (Project Settings -> API). Kalit "publishable/anon": brauzerda boʻlishi moʻljallangan, himoya RLS orqali.
VITE_SUPABASE_URL=https://<loyiha-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Saytning asosiy manzili: sitemap va canonical uchun
VITE_SITE_URL=https://[DOMAIN]
VITE_BRAND_NAME=Izdoshlar
VITE_TELEGRAM_USERNAME=
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
# Rekvizitlar (huquqiy sahifalar va footer): yuridik nom yoki YaTT, STIR (INN), manzil
VITE_LEGAL_NAME=
VITE_LEGAL_INN=
VITE_LEGAL_ADDRESS=
# 1 bo'lsa API javob bermaganda build to'xtaydi (ishlab chiqarishda tavsiya etiladi, eski kontent chiqib ketmasligi uchun)
VITE_REQUIRE_API=0

# Biznes yoʻnalishi (sayt/bot/AI agent xizmatlari, Narxlar sahifasi). 1 = yoqilgan, 0 = yashirin
VITE_ENABLE_BUSINESS=0

# 1 = sayt qidiruv tizimlariga yopiq (sinov muhiti). Haqiqiy ochilishda 0 yoki oʻchiring
VITE_NOINDEX=0
