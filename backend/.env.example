# Nusxa oling: cp .env.example .env   (.env ni hech qachon repoga qo'shmang)
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Ishlab chiqarishda PostgreSQL: postgres://user:pass@host:5432/dbname
# DATABASE_URL=
# Nginx orqasida bo'lsa 1 (haqiqiy IP uchun)
NUM_PROXIES=0
SECURE_SSL_REDIRECT=1

TELEGRAM_BOT_TOKEN=[TELEGRAM_BOT_TOKEN]
TELEGRAM_CHAT_ID=[TELEGRAM_CHAT_ID]

# Mobil operatorlar koʻp abonentni bitta IP ostiga qoʻyadi, shuning uchun juda qattiq qilmang
ORDER_THROTTLE=15/hour
ORDER_THROTTLE_BURST=3/minute
ORDER_MIN_FILL_SECONDS=3

# Kontent (admin) o'zgarganda frontendni qayta build qilish: Vercel/Netlify "Deploy Hook" URL
FRONTEND_DEPLOY_HOOK_URL=
DEPLOY_HOOK_DEBOUNCE_SECONDS=60

# Zaxira bildirishnoma: Telegram ishlamasa shu emailga yuboriladi (boʻsh = oʻchiq)
ORDER_NOTIFY_EMAIL=
DEFAULT_FROM_EMAIL=noreply@sizning-domen.uz
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# HSTS: faqat barcha subdomenlar HTTPS boʻlsa yoqing
HSTS_INCLUDE_SUBDOMAINS=0
HSTS_PRELOAD=0
