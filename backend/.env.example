# Nusxa oling: cp .env.example .env   (.env ni hech qachon repoga qo'shmang)
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Ishlab chiqarishda PostgreSQL: postgres://user:pass@host:5432/dbname
# DATABASE_URL=
# Nginx orqasida bo'lsa 1 (haqiqiy IP uchun)
NUM_PROXIES=0
SECURE_SSL_REDIRECT=1

TELEGRAM_BOT_TOKEN=[TELEGRAM_BOT_TOKEN]
TELEGRAM_CHAT_ID=[TELEGRAM_CHAT_ID]

ORDER_THROTTLE=5/hour
ORDER_THROTTLE_BURST=2/minute
ORDER_MIN_FILL_SECONDS=3

# Kontent (admin) o'zgarganda frontendni qayta build qilish: Vercel/Netlify "Deploy Hook" URL
FRONTEND_DEPLOY_HOOK_URL=
DEPLOY_HOOK_DEBOUNCE_SECONDS=60
